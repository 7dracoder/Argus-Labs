# Copy to .env for local use. Never put real credentials in this tracked file.
# The backend loads .env automatically; restart after editing.

LLM_PROVIDER=gemini
# Quota/rate-limit failover only; GLM credentials below are retained separately.
LLM_FALLBACK_PROVIDER=baseten
LLM_FALLBACK_COOLDOWN_SECONDS=60
# Baseten key: set either BASETEN_API_KEY or the existing GLM_API_KEY.
BASETEN_API_KEY=
GLM_API_KEY=
ZAI_API_KEY=
GLM_MODEL=zai-org/GLM-5.3
GLM_BASE_URL=https://inference.baseten.co/v1
# For direct Z.ai: LLM_PROVIDER=glm, GLM_MODEL=glm-5.3,
# GLM_BASE_URL=https://api.z.ai/api/paas/v4 (or your Coding Plan endpoint).
GLM_REASONING_EFFORT=low

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=SAz9YHcvj6GT2YYXdXww
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_STT_MODEL_ID=scribe_v2
# Live voice ("Talk to Forge"). The backend creates and syncs a private agent
# automatically (id cached in artifacts/voice_agent.json). Set ELEVENLABS_AGENT_ID
# only to use your own agent as-is; it is never modified.
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_LLM=gemini-3.5-flash
ELEVENLABS_AGENT_MAX_SECONDS=600
ELEVENLABS_AGENT_DAILY_LIMIT=100

# Blank uses in-memory development storage.
TIGER_DATABASE_URL=
ROBOFORGE_CAD_ROOT=artifacts/cad

SMARTSPECTRA_API_KEY=
ROBOFORGE_API_URL=http://127.0.0.1:8000
# Snowflake is intentionally not configured.

# Web-search references: You.com now; switch RESEARCH_PROVIDER=tavily later.
RESEARCH_PROVIDER=you
YDC_API_KEY=
# Tavily additionally supports described reference images.
TAVILY_API_KEY=
