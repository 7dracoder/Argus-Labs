# Copy to .env for local use. Never put real credentials in this tracked file.
# The backend loads .env automatically; restart after editing.

LLM_PROVIDER=baseten
# Baseten key: set either BASETEN_API_KEY or the existing GLM_API_KEY.
BASETEN_API_KEY=
GLM_API_KEY=
ZAI_API_KEY=
GLM_MODEL=zai-org/GLM-5.3
GLM_BASE_URL=https://inference.baseten.co/v1
# For direct Z.ai: LLM_PROVIDER=glm, GLM_MODEL=glm-5.3,
# GLM_BASE_URL=https://api.z.ai/api/paas/v4 (or your Coding Plan endpoint).
GLM_REASONING_EFFORT=low

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=SAz9YHcvj6GT2YYXdXww
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_STT_MODEL_ID=scribe_v2

# Blank uses in-memory development storage.
TIGER_DATABASE_URL=
ROBOFORGE_CAD_ROOT=artifacts/cad

SMARTSPECTRA_API_KEY=
ROBOFORGE_API_URL=http://127.0.0.1:8000
# Snowflake is intentionally not configured.
